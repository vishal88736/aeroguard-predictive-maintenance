# Paths are relative to this project. No credentials are needed for local use.
FLEET_DATA_DIR=data/cmapss
FLEET_ARTIFACT_DIR=artifacts
FLEET_RUNTIME_DIR=runtime
# All optional package/model caches stay within this project.
UV_CACHE_DIR=.venv/cache/uv
PIP_CACHE_DIR=.venv/cache/pip
TORCH_HOME=.venv/cache/torch
HF_HOME=.venv/cache/huggingface
MPLCONFIGDIR=.venv/cache/matplotlib
JUPYTER_CONFIG_DIR=.venv/cache/jupyter/config
JUPYTER_DATA_DIR=.venv/cache/jupyter/data
JUPYTER_RUNTIME_DIR=.venv/cache/jupyter/runtime

AEROGUARD_HOST=127.0.0.1
AEROGUARD_PORT=8765
MLFLOW_DISABLE_TELEMETRY=true
MLFLOW_DISABLE_AGENT_HINT=1

# Optional Airflow adapter; the existing AeroGuard UI remains the control center.
AEROGUARD_API_URL=http://127.0.0.1:8765
